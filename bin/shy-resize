#!/usr/bin/env python3
"""Move the split line, not the window.

`resize grow height` moves the border nearest to the focused container, so the
same key grows the upper window downwards and pushes the lower window upwards.
This asks the tree which side the focused container sits on and then picks grow
or shrink so the requested key always moves the divider the same way on screen.

    shy-resize up|down|left|right

Does nothing when the parent does not split along that axis: there is no such
divider to move.
"""

import json
import subprocess
import sys

STEP = "5 ppt"


def focused_path(node, path):
    if node.get("type") == "con" and node.get("focused"):
        return path
    for index, child in enumerate(node.get("nodes", [])):
        found = focused_path(child, path + [index])
        if found is not None:
            return found
    return None


def at(tree, path):
    node = tree
    for index in path:
        node = node["nodes"][index]
    return node


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ("up", "down", "left", "right"):
        sys.exit("usage: shy-resize up|down|left|right")
    want = sys.argv[1]

    tree = json.loads(
        subprocess.run(
            ["swaymsg", "-r", "-t", "get_tree"],
            capture_output=True,
            text=True,
            check=True,
        ).stdout
    )
    path = focused_path(tree, [])
    if not path:
        return
    parent = at(tree, path[:-1])
    index = path[-1]

    vertical = want in ("up", "down")
    if parent.get("layout") != ("splitv" if vertical else "splith"):
        return
    if len(parent.get("nodes", [])) < 2:
        return

    # A sibling after this one means the shared border is below/right of the
    # focused container; otherwise it is above/left.
    border_after = index < len(parent["nodes"]) - 1
    toward_pos = want in ("down", "right")

    if border_after == toward_pos:
        action = "grow"
    else:
        action = "shrink"

    # No room to move (a single child, or a neighbour already at its minimum):
    # swaymsg exits non-zero and nothing changes, which is the right outcome.
    subprocess.run(
        ["swaymsg", "resize", action, "height" if vertical else "width", STEP],
        capture_output=True,
    )


if __name__ == "__main__":
    main()
